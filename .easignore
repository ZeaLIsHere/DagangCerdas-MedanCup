# Force ignore everything that isn't source code
# This is a very aggressive .easignore to fix tar extraction errors on Windows

node_modules/
.expo/
dist/
web-build/
ios/
android/

# Build artifacts
*.tsbuildinfo
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Hidden folders (THE MAIN CAUSE OF PERMISSION DENIED)
.vscode/
.history/
.idea/
.git/
.github/
.expo-shared/

# System junk
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# Credentials & environment (Handled by EAS Secrets)
.env
.env*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Temp files
temp/
tmp/
*.apk
*.aab
*.zip
*.tar.gz
*.tgz
